# Copiar a hosts.ini y cambiar solamente la IP del destino.
# No guardar usuario ni contraseña aquí. Configurar ANSIBLE_REMOTE_USER en la sesión
# del master o usar -u USUARIO al ejecutar Ansible. Autenticación recomendada: llave SSH.
[destinos]
lamp-server ansible_host=192.168.X.X

[destinos:vars]
ansible_become=true
